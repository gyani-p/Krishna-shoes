rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreAdmin() {
      return request.auth != null
        && request.auth.token.email == 'prabalgyani@gmail.com';
    }
    // Public storefront can read; only the designated admin email can write.
    match /products/{id} { allow read: if true; allow create, update, delete: if isStoreAdmin(); }
    match /gallery/{id} { allow read: if true; allow create, update, delete: if isStoreAdmin(); }
    match /notifications/{id} { allow read: if true; allow create, update, delete: if isStoreAdmin(); }
    match /settings/{id} { allow read: if true; allow create, update, delete: if isStoreAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
